# Optional: Pre-mount a default GitHub repository on startup (can also be configured in the UI)
GITHUB_REPO="owner/repo"

# Optional: GitHub Personal Access Token (only required for private repositories or pushing PRs)
# Inject at runtime via environment variables or hosting secrets; never commit real tokens.
GITHUB_TOKEN=""

# Optional: Directory for lightweight workbench config/state persistence (defaults to ./.workbench-data)
# WORKBENCH_DATA_DIR=""

# Optional: Directory for the cloned target Git repository (defaults to <os.tmpdir>/manuscript-workbench-repo
# to stay isolated from cloud IDE workspace snapshot syncs)
# WORKBENCH_REPO_DIR=""
